<mxfile host="app.diagrams.net">
 <diagram name="P1-6b Shared Responsibility" id="aeroforge-luke-1">
  <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="697" math="0" shadow="0">
   <root>
    <mxCell id="0" />
    <mxCell id="1" parent="0" />
    <mxCell id="c3" value="&lt;b&gt;AeroForge — Part 1, Deliverable 6: Shared Responsibility Model&lt;/b&gt;&lt;br&gt;AWS secures the cloud itself | AeroForge secures what it puts in the cloud and the plants | Some duties are shared" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263238;strokeColor=#263238;fontColor=#FFFFFF;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1">
     <mxGeometry x="40" y="20" width="1620" height="60" as="geometry" />
    </mxCell>
    <mxCell id="c4" value="AWS: security OF the cloud" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#E65100;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;arcSize=2;" vertex="1" parent="1">
     <mxGeometry x="40" y="100" width="500" height="487" as="geometry" />
    </mxCell>
    <mxCell id="c5" value="&lt;b&gt;Global infrastructure&lt;/b&gt;&lt;br&gt;• Regions, Availability Zones, edge locations, Direct Connect locations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
     <mxGeometry x="52" y="134" width="476" height="48" as="geometry" />
    </mxCell>
    <mxCell id="c6" value="&lt;b&gt;Hardware and physical security&lt;/b&gt;&lt;br&gt;• Data centers, hosts, network hardware, hypervisor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
     <mxGeometry x="52" y="196" width="476" height="48" as="geometry" />
    </mxCell>
    <mxCell id="c7" value="&lt;b&gt;Managed-service operation&lt;/b&gt;&lt;br&gt;• Runs and patches S3, Kinesis, Glue, Athena, Redshift Serverless, DynamoDB, IoT Core, Bedrock, QuickSight, KMS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
     <mxGeometry x="52" y="258" width="476" height="63" as="geometry" />
    </mxCell>
    <mxCell id="c8" value="&lt;b&gt;Built-in protections&lt;/b&gt;&lt;br&gt;• Durability and availability design, HSM-backed KMS, service encryption options&lt;br&gt;• Compliance reports available in AWS Artifact" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#E65100;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
     <mxGeometry x="52" y="335" width="476" height="63" as="geometry" />
    </mxCell>
    <mxCell id="c9" value="SHARED: both sides act" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#F57F17;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;arcSize=2;" vertex="1" parent="1">
     <mxGeometry x="570" y="100" width="500" height="487" as="geometry" />
    </mxCell>
    <mxCell id="c10" value="&lt;b&gt;Patch management&lt;/b&gt;&lt;br&gt;• AWS patches managed services; AeroForge patches Greengrass edge gateways and on-prem MES / ERP hosts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
     <mxGeometry x="582" y="134" width="476" height="63" as="geometry" />
    </mxCell>
    <mxCell id="c11" value="&lt;b&gt;Configuration management&lt;/b&gt;&lt;br&gt;• AWS secures service defaults; AeroForge chooses and reviews the settings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
     <mxGeometry x="582" y="211" width="476" height="48" as="geometry" />
    </mxCell>
    <mxCell id="c12" value="&lt;b&gt;Awareness and training&lt;/b&gt;&lt;br&gt;• AWS trains its staff; AeroForge trains plant and engineering users, especially on TALON handling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
     <mxGeometry x="582" y="273" width="476" height="63" as="geometry" />
    </mxCell>
    <mxCell id="c13" value="&lt;b&gt;Compliance evidence&lt;/b&gt;&lt;br&gt;• AWS supplies audit reports; AeroForge maps them to SOX and export-control controls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
     <mxGeometry x="582" y="350" width="476" height="63" as="geometry" />
    </mxCell>
    <mxCell id="c14" value="AeroForge: security IN the cloud and at the plants" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#2E7D32;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=12;arcSize=2;" vertex="1" parent="1">
     <mxGeometry x="1100" y="100" width="560" height="487" as="geometry" />
    </mxCell>
    <mxCell id="c15" value="&lt;b&gt;Data&lt;/b&gt;&lt;br&gt;• Classify (commercial, TALON, PII), tag, retain, and validate quality" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
     <mxGeometry x="1112" y="134" width="536" height="48" as="geometry" />
    </mxCell>
    <mxCell id="c16" value="&lt;b&gt;Identity and access&lt;/b&gt;&lt;br&gt;• IAM Identity Center, IAM roles, Lake Formation grants, row-level security, key policies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
     <mxGeometry x="1112" y="196" width="536" height="48" as="geometry" />
    </mxCell>
    <mxCell id="c17" value="&lt;b&gt;Encryption choices&lt;/b&gt;&lt;br&gt;• Pick customer-managed keys per tier (CMK #1 to #4), rotation and key policies" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
     <mxGeometry x="1112" y="258" width="536" height="48" as="geometry" />
    </mxCell>
    <mxCell id="c18" value="&lt;b&gt;Network design&lt;/b&gt;&lt;br&gt;• VPCs, security groups, endpoints, Transit Gateway, VPN / Direct Connect to plants" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
     <mxGeometry x="1112" y="320" width="536" height="48" as="geometry" />
    </mxCell>
    <mxCell id="c19" value="&lt;b&gt;Application and agent settings&lt;/b&gt;&lt;br&gt;• Guardrails, agent tool permissions, human approval for risky actions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
     <mxGeometry x="1112" y="382" width="536" height="48" as="geometry" />
    </mxCell>
    <mxCell id="c20" value="&lt;b&gt;Logging, monitoring, compliance&lt;/b&gt;&lt;br&gt;• Turn on and review CloudTrail / Config / alarms; SOX, export control, Mexico privacy rules; legal review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#2E7D32;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
     <mxGeometry x="1112" y="444" width="536" height="63" as="geometry" />
    </mxCell>
    <mxCell id="c21" value="&lt;b&gt;Plants (fully AeroForge)&lt;/b&gt;&lt;br&gt;• Greengrass devices, plant networks, MES, ERP, operator-ID stripping at the edge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#616161;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
     <mxGeometry x="1112" y="521" width="536" height="48" as="geometry" />
    </mxCell>
    <mxCell id="c22" value="&lt;b&gt;Rule of thumb&lt;/b&gt;&lt;br&gt;• The more managed the service (Redshift Serverless, Bedrock), the less AWS-side setup AeroForge runs, but data, identity, keys and compliance always stay with AeroForge." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F57F17;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=8;" vertex="1" parent="1">
     <mxGeometry x="40" y="617" width="1620" height="48" as="geometry" />
    </mxCell>
   </root>
  </mxGraphModel>
 </diagram>
</mxfile>